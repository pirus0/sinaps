  },
  {
   "id": "k-snr",
   "tuvalId": "t-fotosentez",
   "baslik": "Sınırlayıcı etmen ilkesi",
   "aciklama": "Birden çok etmenin etkilediği bir süreçte hızı en yetersiz olan etmen belirler. F. F. Blackman 1905'te bu ilkeyi fotosentez için ortaya koydu.",
   "x": -560,
   "y": -496,
   "kaynakId": "k-etm",
