 "kartlar": [
  {
   "id": "k-kok",
   "tuvalId": "t-fotosentez",
   "baslik": "Fotosentez",
   "aciklama": "Bitkilerin, alglerin ve siyanobakterilerin ışık enerjisiyle karbondioksit ve sudan glikoz üretip oksijen açığa çıkardığı süreç.\n\n6CO₂ + 6H₂O + ışık → C₆H₁₂O₆ + 6O₂",
   "x": 0,
   "y": -164,
   "kaynakId": null,
   "olusturma": "2026-11-09T09:00:00.000Z",
   "degisme": "2026-11-09T09:00:00.000Z"
  },
  {
   "id": "k-yer",
   "tuvalId": "t-fotosentez",
   "baslik": "Nerede gerçekleşir",
   "aciklama": "Bitkilerde fotosentez kloroplastlarda olur. Yapraktaki mezofil hücreleri kloroplast bakımından en zengin hücrelerdir.",
   "x": 300,
   "y": -844,
   "kaynakId": "k-kok",
   "olusturma": "2026-11-09T09:00:00.000Z",
   "degisme": "2026-11-09T09:00:00.000Z"
  },
  {
   "id": "k-klp",
   "tuvalId": "t-fotosentez",
   "baslik": "Kloroplast",
   "aciklama": "Çift zarlı bir organel. İçinde tilakoit adlı yassı keseler ve bunları saran stroma sıvısı bulunur. Kendi DNA'sı ve ribozomları vardır.",
   "x": 560,
   "y": -1018,
   "kaynakId": "k-yer",
   "olusturma": "2026-11-09T09:00:00.000Z",
   "degisme": "2026-11-09T09:00:00.000Z"
  },
  {
   "id": "k-til",
   "tuvalId": "t-fotosentez",
   "baslik": "Tilakoit zarı",
   "aciklama": "Işığa bağlı tepkimelerin yeri. Klorofil ve fotosistemler bu zarın içindedir. Tilakoitler üst üste dizilerek granumları oluşturur.",
   "x": 560,
   "y": -902,
   "kaynakId": "k-yer",
   "olusturma": "2026-11-09T09:00:00.000Z",
   "degisme": "2026-11-09T09:00:00.000Z"
  },
  {
   "id": "k-str",
   "tuvalId": "t-fotosentez",
   "baslik": "Stroma",
   "aciklama": "Kloroplastın iç sıvısı. Calvin döngüsü burada gerçekleşir; Rubisco başta olmak üzere döngünün enzimleri stromada bulunur.",
   "x": 560,
   "y": -786,
   "kaynakId": "k-yer",
   "olusturma": "2026-11-09T09:00:00.000Z",
   "degisme": "2026-11-09T09:00:00.000Z"
  },
  {
   "id": "k-sto",
   "tuvalId": "t-fotosentez",
   "baslik": "Stoma",
   "aciklama": "Yapraktaki gözenekler. CO₂ buradan girer, O₂ ve su buharı buradan çıkar. İki bekçi hücresi gözeneğin açılıp kapanmasını düzenler.",
   "x": 560,
   "y": -670,
   "kaynakId": "k-yer",
   "olusturma": "2026-11-09T09:00:00.000Z",
   "degisme": "2026-11-09T09:00:00.000Z"
  },
  {
   "id": "k-pig",
   "tuvalId": "t-fotosentez",
   "baslik": "Pigmentler",
   "aciklama": "Işığı soğuran moleküller. Soğurdukları renkler, fotosentezde hangi ışığın kullanıldığını belirler.",
   "x": 300,
   "y": -378,
   "kaynakId": "k-kok",
   "olusturma": "2026-11-09T09:00:00.000Z",
   "degisme": "2026-11-09T09:00:00.000Z"
  },
  {
   "id": "k-kla",
   "tuvalId": "t-fotosentez",
   "baslik": "Klorofil a",
   "aciklama": "Ana fotosentez pigmenti. En çok mavi-mor ve kırmızı ışığı soğurur, yeşili yansıtır; yapraklar bu yüzden yeşil görünür.",
   "x": 560,
   "y": -494,
   "kaynakId": "k-pig",
   "olusturma": "2026-11-09T09:00:00.000Z",
   "degisme": "2026-11-09T09:00:00.000Z"
  },
  {
   "id": "k-yrd",
   "tuvalId": "t-fotosentez",
   "baslik": "Klorofil b ve karotenoitler",
   "aciklama": "Yardımcı pigmentler: soğurdukları enerjiyi klorofil a'ya aktarırlar. Karotenoitler fazla ışığa karşı da korur. Sonbaharda klorofil yıkılınca sarı-turuncu renkleri görünür hale gelir.",
   "x": 560,
   "y": -378,
   "kaynakId": "k-pig",
   "olusturma": "2026-11-09T09:00:00.000Z",
   "degisme": "2026-11-09T09:00:00.000Z"
  },
  {
   "id": "k-spk",
   "tuvalId": "t-fotosentez",
   "baslik": "Soğurma spektrumu",
   "aciklama": "Bir pigmentin hangi dalga boylarını ne kadar soğurduğunu gösteren eğri. Fotosentez hızının dalga boyuna göre değişimi (etki spektrumu) klorofilin soğurma eğrisine benzer.",
   "x": 560,
   "y": -262,
   "kaynakId": "k-pig",
   "olusturma": "2026-11-09T09:00:00.000Z",
   "degisme": "2026-11-09T09:00:00.000Z"
  },
  {
   "id": "k-isk",
   "tuvalId": "t-fotosentez",
   "baslik": "Işığa bağlı tepkimeler",
   "aciklama": "Tilakoit zarında ışık enerjisi kimyasal enerjiye çevrilir. Ürünler ATP, NADPH ve O₂'dir; ATP ve NADPH Calvin döngüsüne gider.",
   "x": 300,
   "y": 88,
   "kaynakId": "k-kok",
   "olusturma": "2026-11-09T09:00:00.000Z",
   "degisme": "2026-11-09T09:00:00.000Z"
  },
  {
   "id": "k-ps2",
   "tuvalId": "t-fotosentez",
   "baslik": "Fotosistem II",
   "aciklama": "Işıkla uyarılan klorofil elektron verir. Eksilen elektronlar suyun parçalanmasıyla (fotoliz) yerine konur; bu sırada O₂ açığa çıkar. Fotosentezdeki oksijenin kaynağı sudur.",
   "x": 560,
   "y": -86,
   "kaynakId": "k-isk",
   "olusturma": "2026-11-09T09:00:00.000Z",
   "degisme": "2026-11-09T09:00:00.000Z"
  },
  {
   "id": "k-etz",
   "tuvalId": "t-fotosentez",
   "baslik": "Elektron taşıma zinciri",
   "aciklama": "Elektronlar Fotosistem II'den Fotosistem I'e taşınırken açığa çıkan enerjiyle tilakoit boşluğuna H⁺ iyonları pompalanır.",
   "x": 560,
   "y": 30,
   "kaynakId": "k-isk",
   "olusturma": "2026-11-09T09:00:00.000Z",
   "degisme": "2026-11-09T09:00:00.000Z"
  },
  {
   "id": "k-ps1",
   "tuvalId": "t-fotosentez",
   "baslik": "Fotosistem I ve NADPH",
   "aciklama": "Fotosistem I'de ışıkla yeniden uyarılan elektronlar, NADP⁺'yı NADPH'ye indirger. NADPH Calvin döngüsünde indirgeyici olarak kullanılır.",
   "x": 560,
   "y": 146,
   "kaynakId": "k-isk",
   "olusturma": "2026-11-09T09:00:00.000Z",
   "degisme": "2026-11-09T09:00:00.000Z"
  },
  {
   "id": "k-atp",
   "tuvalId": "t-fotosentez",
   "baslik": "ATP sentaz",
   "aciklama": "Tilakoit boşluğunda biriken H⁺ iyonları, ATP sentaz enziminden geçerek stromaya geri akar. Bu akışın enerjisiyle ADP'den ATP üretilir.\n\nBu yola kemiozmoz, ışık enerjisiyle ATP üretimine de fotofosforilasyon denir. Aynı ilke mitokondride hücresel solunumda da çalışır; orada enerji kaynağı ışık değil, besinlerden gelen elektronlardır.",
   "x": 560,
   "y": 262,
   "kaynakId": "k-isk",
   "olusturma": "2026-11-09T09:00:00.000Z",
   "degisme": "2026-11-09T09:00:00.000Z"
  },
  {
   "id": "k-clv",
   "tuvalId": "t-fotosentez",
   "baslik": "Calvin döngüsü",
   "aciklama": "Stromada CO₂'nin şekere çevrildiği tepkimeler dizisi. Işık tepkimelerinin ürettiği ATP ve NADPH'yi kullanır.",
   "x": 300,
   "y": 728,
   "kaynakId": "k-kok",
   "olusturma": "2026-11-09T09:00:00.000Z",
   "degisme": "2026-11-09T09:00:00.000Z"
  },
  {
   "id": "k-ktt",
   "tuvalId": "t-fotosentez",
   "baslik": "Karbon tutma",
   "aciklama": "Rubisco, CO₂'yi beş karbonlu RuBP'ye bağlar. Oluşan altı karbonlu ara ürün hemen ikiye bölünür ve iki adet üç karbonlu 3-fosfogliserat oluşur.",
   "x": 560,
   "y": 438,
   "kaynakId": "k-clv",
   "olusturma": "2026-11-09T09:00:00.000Z",
   "degisme": "2026-11-09T09:00:00.000Z"
  },
  {
   "id": "k-ind",
   "tuvalId": "t-fotosentez",
   "baslik": "İndirgeme",
   "aciklama": "3-fosfogliserat, ATP ve NADPH harcanarak gliseraldehit-3-fosfata (G3P) dönüştürülür. G3P üç karbonlu bir şekerdir.",
   "x": 560,
   "y": 554,
   "kaynakId": "k-clv",
   "olusturma": "2026-11-09T09:00:00.000Z",
   "degisme": "2026-11-09T09:00:00.000Z"
  },
  {
   "id": "k-yen",
   "tuvalId": "t-fotosentez",
   "baslik": "Yenilenme",
   "aciklama": "Oluşan G3P'nin çoğu, ATP harcanarak yeniden RuBP'ye çevrilir. Böylece döngü yeni CO₂ tutmaya hazır olur.",
   "x": 560,
   "y": 670,
   "kaynakId": "k-clv",
   "olusturma": "2026-11-09T09:00:00.000Z",
   "degisme": "2026-11-09T09:00:00.000Z"
  },
  {
   "id": "k-urn",
   "tuvalId": "t-fotosentez",
   "baslik": "Ürünler",
   "aciklama": "Döngünün her üç turunda bir G3P net kazanılır. İki G3P'den bir glikoz yapılabilir. Şeker nişasta olarak depolanır, sakkaroz olarak taşınır, selüloz yapımında kullanılır.",
   "x": 560,
   "y": 786,
   "kaynakId": "k-clv",
   "olusturma": "2026-11-09T09:00:00.000Z",
   "degisme": "2026-11-09T09:00:00.000Z"
  },
  {
   "id": "k-rub",
   "tuvalId": "t-fotosentez",
   "baslik": "Rubisco",
   "aciklama": "Karbon tutmayı yapan enzim; Dünya'da en bol bulunan protein olduğu düşünülür. Yavaş çalışır, bu yüzden bitkiler onu çok miktarda üretir.\n\nRubisco CO₂ yerine O₂'yi de bağlayabilir. Bu yan tepkimeye fotorespirasyon denir: tutulmuş karbonun bir kısmı CO₂ olarak geri kaybedilir ve enerji harcanır. Sıcak ve kurak havada yaprak içinde O₂ birikip CO₂ azaldığında bu kayıp büyür.",
   "x": 560,
   "y": 902,
   "kaynakId": "k-clv",
   "olusturma": "2026-11-09T09:00:00.000Z",
   "degisme": "2026-11-09T09:00:00.000Z"
  },
  {
   "id": "k-isz",
   "tuvalId": "t-fotosentez",
   "baslik": "\"Işıktan bağımsız\" adı",
   "aciklama": "Calvin döngüsü ışığı doğrudan kullanmaz ama ışık tepkimelerinin ATP ve NADPH'sine muhtaçtır; bazı enzimleri de ışıkla etkinleşir. Bu yüzden pratikte gündüz çalışır.",
   "x": 560,
   "y": 1018,
   "kaynakId": "k-clv",
   "olusturma": "2026-11-09T09:00:00.000Z",
   "degisme": "2026-11-09T09:00:00.000Z"
  },
  {
   "id": "k-etm",
   "tuvalId": "t-fotosentez",
   "baslik": "Etkileyen etmenler",
   "aciklama": "Fotosentez hızı ışığa, CO₂'ye, sıcaklığa ve suya bağlıdır. Hızı o an en kıt olan etmen belirler.",
   "x": -300,
   "y": -728,
   "kaynakId": "k-kok",
   "olusturma": "2026-11-09T09:00:00.000Z",
