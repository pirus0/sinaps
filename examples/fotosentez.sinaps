  {
   "id": "k-prs",
   "tuvalId": "t-fotosentez",
   "baslik": "Priestley ve Ingenhousz",
   "aciklama": "Priestley (1771): kapalı kapta mumun söndürdüğü havayı bir nane dalının yeniden yanmaya elverişli hale getirdiğini gösterdi. Ingenhousz (1779): bu etkinin yalnız ışıkta ve bitkinin yeşil kısımlarında görüldüğünü buldu.",
   "x": -560,
   "y": 612,
   "kaynakId": "k-trh",
   "olusturma": "2026-11-09T09:00:00.000Z",
   "degisme": "2026-11-09T09:00:00.000Z"
  },
  {
   "id": "k-eng",
   "tuvalId": "t-fotosentez",
   "baslik": "Engelmann deneyi",
   "aciklama": "1882'de bir alg ipliğini prizmayla renklere ayrılmış ışık altında inceledi. Oksijen seven bakteriler en çok mavi ve kırmızı ışık alan bölgelerde toplandı: fotosentez en çok bu ışıklarda oluyordu.",
   "x": -560,
   "y": 728,
   "kaynakId": "k-trh",
   "olusturma": "2026-11-09T09:00:00.000Z",
   "degisme": "2026-11-09T09:00:00.000Z"
  },
  {
   "id": "k-rk",
   "tuvalId": "t-fotosentez",
   "baslik": "Ruben ve Kamen",
   "aciklama": "1941'de ağır oksijen izotopu (¹⁸O) ile işaretli su kullandılar. Açığa çıkan oksijenin CO₂'den değil sudan geldiğini gösterdiler.",
   "x": -560,
   "y": 844,
   "kaynakId": "k-trh",
   "olusturma": "2026-11-09T09:00:00.000Z",
